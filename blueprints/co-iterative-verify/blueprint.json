{
  "schemaVersion": 3,
  "id": "co-iterative-verify",
  "version": "1.0.0",
  "title": "并线迭代开发与统一验证",
  "description": "基于已批准规格并行准备共享基础与功能回归清单，再在大颗粒 git worktree 中并线迭代开发与并行编写验证测试用例，最终在合并后做完整功能验证并经用户决策通过。",
  "startNode": "spec_plan",
  "nodes": [
    {
      "id": "spec_plan",
      "title": "并线计划与任务播种",
      "x": 100,
      "y": 200,
      "modelTier": "heavy",
      "approvalAsk": true
    },
    {
      "id": "foundation_inventory_parallel",
      "kind": "parallel",
      "title": "基础与回归清单并行",
      "x": 340,
      "y": 200,
      "branches": [
        {
          "branchId": "foundation",
          "body": {
            "startNode": "foundation_prepare",
            "nodes": [
              {
                "id": "foundation_prepare",
                "title": "共享基础串行准备",
                "x": 80,
                "y": 70,
                "modelTier": "heavy"
              }
            ],
            "edges": []
          },
          "workspace": "direct"
        },
        {
          "branchId": "acceptance",
          "body": {
            "startNode": "functional_regression_inventory",
            "nodes": [
              {
                "id": "functional_regression_inventory",
                "title": "功能回归清单与审阅",
                "x": 80,
                "y": 70,
                "modelTier": "heavy"
              }
            ],
            "edges": []
          },
          "workspace": "readonly"
        }
      ],
      "maxConcurrent": 2,
      "workspace": "readonly"
    },
    {
      "id": "parallel_delivery",
      "kind": "parallel",
      "title": "开发块并线交付",
      "x": 650,
      "y": 200,
      "iterator": {
        "kind": "tasks",
        "tasksSchemaRef": "development"
      },
      "body": {
        "startNode": "block_implement",
        "nodes": [
          {
            "id": "block_implement",
            "title": "开发块实现与测试用例编写",
            "x": 70,
            "y": 70,
            "modelTier": "heavy"
          },
          {
            "id": "block_verify",
            "title": "开发块功能自验",
            "x": 330,
            "y": 70,
            "modelTier": "heavy",
            "onFail": {
              "rewindTo": "block_implement",
              "ticketTitle": "开发块功能自验失败，原 worktree 内聚合修复",
              "maxAttempts": 3,
              "when": "status == \"failed\""
            }
          }
        ],
        "edges": [
          {
            "from": "block_implement",
            "to": "block_verify",
            "when": "status == \"ok\""
          }
        ]
      },
      "maxConcurrent": 3,
      "workspace": "worktree",
      "gitInit": true,
      "worktreeRequired": true
    },
    {
      "id": "repair_orchestrator",
      "title": "跨阶段整体修复",
      "x": 900,
      "y": 420,
      "modelTier": "heavy"
    },
    {
      "id": "integrate",
      "title": "合并与启动复核",
      "x": 1060,
      "y": 200,
      "onFail": {
        "rewindTo": "repair_orchestrator",
        "ticketTitle": "合并或启动复核失败，进入跨实例整体修复",
        "maxAttempts": 3,
        "when": "status == \"failed\""
      },
      "modelTier": "heavy"
    },
    {
      "id": "functional_validation",
      "title": "完整功能验证",
      "x": 1350,
      "y": 200,
      "onFail": {
        "rewindTo": "repair_orchestrator",
        "ticketTitle": "完整功能验证失败，进入跨实例整体修复",
        "maxAttempts": 3,
        "when": "status == \"failed\""
      },
      "modelTier": "heavy",
      "approvalAsk": true,
      "terminalWhen": "status == \"ok\" && next_input.__decision == \"Passed\""
    }
  ],
  "edges": [
    {
      "from": "spec_plan",
      "to": "foundation_inventory_parallel",
      "when": "status == \"ok\""
    },
    {
      "from": "foundation_inventory_parallel",
      "to": "parallel_delivery",
      "when": "status == \"ok\""
    },
    {
      "from": "parallel_delivery",
      "to": "integrate",
      "when": "status == \"ok\""
    },
    {
      "from": "parallel_delivery",
      "to": "integrate",
      "when": "status == \"failed\""
    },
    {
      "from": "parallel_delivery",
      "to": "integrate",
      "when": "status == \"blocked\""
    },
    {
      "from": "integrate",
      "to": "functional_validation",
      "decision": "Passed"
    },
    {
      "from": "repair_orchestrator",
      "to": "integrate",
      "decision": "ReturnIntegrate"
    },
    {
      "from": "repair_orchestrator",
      "to": "functional_validation",
      "decision": "ReturnFunctionalValidation"
    }
  ],
  "tasksSchemas": {
    "development": {
      "requiredFields": {
        "id": {
          "type": [
            "string",
            "number"
          ],
          "description": "开发块唯一标识"
        },
        "title": {
          "type": "string",
          "description": "开发块标题"
        },
        "status": {
          "type": "string",
          "default": "pending",
          "description": "运行时由 iterator 设置"
        },
        "goal": {
          "type": "string",
          "description": "开发块业务目标"
        },
        "repo": {
          "type": "string",
          "format": "abs-path",
          "description": "目标仓库绝对路径"
        },
        "scope": {
          "type": "string",
          "description": "开发块路径范围（人类可读）"
        },
        "owned_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "本实例独占写集；与其他实例不得重叠"
        },
        "protected_shared_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "禁止本实例修改的共享文件清单"
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "本实例依赖的共享契约标识；跨实例契约冻结后不可修改"
        },
        "done_when": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "完成条件清单（人类可读）"
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "timeoutMs": {
                "type": "integer",
                "default": 300000
              },
              "expectedExitCode": {
                "type": "integer",
                "default": 0
              }
            }
          },
          "minItems": 1,
          "description": "验证命令清单；block_verify 阶段按顺序执行，任意 expectedExitCode 不匹配即视为 block_verify 失败"
        }
      },
      "recommendedFields": {},
      "userFields": {},
      "extensionFieldsAllowed": false,
      "doneValues": [
        "done"
      ],
      "example": {
        "id": "backend-orders",
        "title": "订单后端模块",
        "status": "pending",
        "goal": "完成订单模块本轮全部后端功能",
        "repo": "D:/project/app",
        "scope": "backend/module/orders",
        "owned_paths": [
          "server/orders/"
        ],
        "protected_shared_paths": [
          "server/routes/index.js"
        ],
        "interfaces": [
          "CON-ORDER-API-v2"
        ],
        "done_when": [
          "批准的订单主流程全部通过"
        ],
        "verification": [
          {
            "name": "unit-tests",
            "command": "node --test server/orders/__tests__/*.test.js",
            "timeoutMs": 300000,
            "expectedExitCode": 0
          }
        ]
      }
    }
  },
  "tags": [
    "parallel",
    "sdd",
    "co-iterative-verify"
  ],
  "author": "Shannon"
}